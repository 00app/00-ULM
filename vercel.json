{
  "regions": ["lhr1"],
  "framework": "nextjs",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "node scripts/vercel-build-gate.mjs",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },
  "crons": [
    {
      "path": "/api/cron/zone-research?limit=3",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/repair-mechanical?limit=20",
      "schedule": "0 6 * * *"
    }
  ]
}
