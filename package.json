    "pipeline:seed:http": "bash scripts/seed-zone-research-all.sh --env-file .env.local http://127.0.0.1:3000",
    "curl:scrape-sync": "bash scripts/curl-scrape-sync-trigger.sh",
    "scrape:fresh": "bash scripts/seed-zone-research-all.sh --env-file .vercel/.env.production.local",
    "hermes:ping": "bash scripts/hermes-pulse.sh --auth-only",
    "hermes:pulse": "bash scripts/hermes-pulse.sh --smoke",
    "hermes:repair-pulse": "bash scripts/hermes-pulse.sh --repair-only",
    "twilio:ping": "tsx scripts/twilio-ping.ts",
    "twilio:configure-webhook": "tsx scripts/twilio-configure-webhook.ts",
    "db:log-research-user": "tsx scripts/log-latest-research-row.ts",
    "db:repair-research-user": "tsx scripts/repair-latest-research-row.ts",
    "db:repair-mechanical": "tsx scripts/repair-mechanical-12k-truth.ts",
    "db:repair-row726": "tsx scripts/repair-latest-research-row.ts --id=726",
    "db:audit": "tsx scripts/audit-neon-tables.ts",
    "zone:audit-gates": "tsx scripts/audit-zone-research-gates.ts",
    "db:verify-discovery": "tsx scripts/verify-discovery-schema.ts"
