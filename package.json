    "dev:open": "WATCHPACK_POLLING=1 CHOKIDAR_USEPOLLING=true node scripts/ensure-dev-manifests.js && WATCHPACK_POLLING=1 CHOKIDAR_USEPOLLING=true node node_modules/.bin/next dev --webpack -p 3030 -H 0.0.0.0",
    "run": "rm -rf .next node_modules/.cache && WATCHPACK_POLLING=1 CHOKIDAR_USEPOLLING=true node scripts/ensure-dev-manifests.js && WATCHPACK_POLLING=1 CHOKIDAR_USEPOLLING=true node node_modules/.bin/next dev --webpack -p 3030 -H 0.0.0.0",
