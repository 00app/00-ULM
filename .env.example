# Neon PostgreSQL — get connection string from https://console.neon.tech
# Copy to .env.local for local dev. For Vercel: Project → Settings → Environment Variables.
# Then run: npm run init-db (applies lib/schema.sql to Neon).

# Do NOT commit real credentials. Use .env.local (gitignored) for all secrets.
# Day-to-day: edit .env.local only. Refresh: vercel env pull .env.local --environment=production --yes
# Other files (.env.vercel.pull, .env.production.local) are pull snapshots — see docs/DEV-TEST-AUDIT.md

# Neon PostgreSQL — get connection string from https://console.neon.tech
# Pooler host often ends in `-pooler.<region>.aws.neon.tech`. Neon UI may append `&channel_binding=require`.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true

# Vercel AI Gateway (full API access — vck_… key from Vercel → AI Gateway). Used by the `ai` SDK / @ai-sdk/gateway.
# Vercel Production may also set VERCEL_AI_GATEWAY_API_KEY (same vck key). OIDC: VERCEL_OIDC_TOKEN after `vercel env pull`.
# Set in .env.local only. Do not commit real keys.
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
# --- Zero Zero (00-ULM) — API bucket failover (use less, more) ---
# Copy keys into .env.local / Vercel Production only. Never commit real values.
#
# Primary: Google AI Studio (Flash — forensic triplet / Zai / scrape-sync).
# New API keys often reject gemini-1.5-* ; this repo defaults to gemini-2.5-flash.
# MODEL_STRATEGY=bucket_failover — provider chain; blocks broad scrapes by default.
# GEMINI_FREE_TIER=1 — use gemini-2.0-flash-lite + skip paid Gemini in bucket (use with Groq key).
# BUCKET_SKIP_GEMINI=1 — same as free-tier for bucket order: Groq → Mistral → OpenRouter only.
# ALLOW_BROAD_SCRAPE=1 — allow GET scrape-sync ?force=true and cron full batch (audit only).
# BUCKET_SKIP_DEEP_GEMINI=1 — skip second-pass deep Gemini outside bucket mode (optional).
# Hermes cron: use ?repair=1 (auto in bucket mode) or ?full=1 for multi-user pulse.

# --- Zero-cost production profile (recommended) ---
MODEL_STRATEGY=bucket_failover
MAX_ITERATIONS=5
GEMINI_FREE_TIER=1
BUCKET_SKIP_GEMINI=1
# Groq-first research prose; Gemini Flash only if you clear the two flags above
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
# Firecrawl: earned JIT only in bucket mode (no ?force=true). Set 1 to disable all scrapes.
SKIP_FIRECRAWL=0
# JIT scrape-sync / Hermes repair use mechanical triplets unless you opt in:
# ALLOW_LLM_TRIPLET=1
# ALLOW_CONTENT_ARCHITECT_LLM=1
# ALLOW_BROAD_SCRAPE=1
# RESEARCH_PROVIDER_LOG=1 — log [bucket_failover] provider per LLM call in server logs
# ALLOW_BROAD_SCRAPE=
# BUCKET_SKIP_DEEP_GEMINI=
# ALLOW_LLM_TRIPLET=1 — opt into Groq/Mistral triplet extraction in bucket mode (default: mechanical only)
# ALLOW_CONTENT_ARCHITECT_LLM=1 — opt into batch content-architect LLM in bucket mode (default: mechanical)
# DATABASE_USE_NEON_SERVERLESS=0 — force node-pg TCP pool (local dev default). Set =1 to test Neon WebSocket pool.

# Primary — Google AI Studio (paid cap — lower spend cap in AI Studio or use BUCKET_SKIP_GEMINI)
GEMINI_API_KEY=
# With GEMINI_FREE_TIER=1 defaults become flash-lite; else 2.5-flash:
GEMINI_ZONE_MODEL=gemini-2.5-flash
GEMINI_ARTICLE_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Fallback 1 — Groq free tier (recommended primary when Gemini cap hit)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Fallback 2 — Mistral (free dev tier on signup)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Fallback 3 — OpenRouter (use :free models when BUCKET_SKIP_GEMINI)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Vercel AI Gateway (optional hop before direct Gemini). Slugs use google/… prefix.
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL_ZONE=google/gemini-2.5-flash
# AI_GATEWAY_MODEL_ARTICLE=google/gemini-2.5-flash
# AI_GATEWAY_MODEL_CHAT=google/gemini-2.5-flash
# RESEARCH_FORCE_DIRECT_GEMINI=true (default) — scrape-sync uses direct Gemini first; false = gateway chain.

# --- Internal webhooks (optional): Hermes / scripts POST to /api/zone/tips-inject, /api/agents/pulse ---
# Use a long random server-only string. Same family as CRON_SECRET is fine if you keep one secret.
GATEWAY_TOKEN=

# Firecrawl: Sentinel + ZeroResearch scrapes (The Eyes).
# Resolution order: FIRE_CRAWL_KEY_3 → FIRE_CRAWL_KEY_2 → FIRECRAWL_API_KEY (lib/sentinel/api-config.ts).
# Cursor MCP (`.cursor/mcp.json` → firecrawl): same key via `node scripts/run-firecrawl-mcp.mjs`.
FIRE_CRAWL_KEY_3=
FIRE_CRAWL_KEY_2=
# FIRECRAWL_API_KEY=

# Cron / admin: long random string (min 16 chars). Required for GET|POST /api/cron/zone-research and diagnostics gates.
# Set in Vercel: Project → Settings → Environment Variables → Production (and Preview if cron runs there).
# CLI: `vercel env add CRON_SECRET` (paste value when prompted) then redeploy.
CRON_SECRET=

# Ops / admin API bearer — `/api/admin/*`, `/admin/pulse`, `/api/health/diagnostics` (full), `/api/agents/pulse`.
# Use a distinct value from CRON_SECRET (≥16 chars). Authorization: Bearer <GATEWAY_TOKEN>
GATEWAY_TOKEN=

# HMAC signing for HTTP-only session + zz_sid cookies (min 16 chars). Server-only — never NEXT_PUBLIC_*.
# Generate: `openssl rand -base64 32`. Required in production for signed cookies.
SESSION_SECRET=

# Admin `/api/admin/*` + `/admin/pulse` — server-only (never NEXT_PUBLIC_*).
# Set in Vercel: Project → Settings → Environment Variables → ADMIN_PASSWORD
# ADMIN_PASSWORD=            # HTTP Basic password (any username in the browser prompt)
# ADMIN_BASIC_AUTH=          # Optional curl override: full Authorization header value

# v1.8.14 — Legacy WhatsApp env blocked. Use Twilio SMS vars below instead.

# Twilio SMS — Rock mobile signup welcome + STOP/START via /api/webhooks/twilio
# Vercel: Project → Settings → Environment Variables → Production + Preview (not user mobiles).
# Local: merge via `export TWILIO_*=… && node scripts/merge-env-local.mjs` — never commit values.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=                        # server-only; rotate if exposed
# TWILIO_PHONE_NUMBER=+447576569100           # Live FROM number (E.164) — the only phone number in env
# NEXT_PUBLIC_APP_URL=https://www.00-00.online   # webhook base; must match Twilio console + signature check
# TWILIO_WEBHOOK_URL=https://www.00-00.online/api/webhooks/twilio  # optional full-URL override
# TWILIO_MESSAGING_ENABLED=0                # optional kill switch (default: send when FROM number is set)
# Use LIVE credentials from Twilio Console (not Test credentials). Test SID/token are for magic test numbers only.
# Do not put user personal mobiles in env — they save to Neon via POST /api/profile/mobile.
# Trial-only: Twilio Console → Verified Caller IDs is optional for manual smoke tests; not required in Vercel/app config.
# Setup: npm run twilio:ping · npm run twilio:configure-webhook · see docs/FULL-APP-SPEC.md §6.8

# Show floating Nervous System diagnostics (triangle, bottom-right). Default: dev only. Set to 1 for prod demos.
# NEXT_PUBLIC_PULSE_WIDGET=1

# Scrapers / Hermes handshake — POST /api/scrape-sync (production requires ≥16-char secret).
# Auth: Authorization: Bearer <SCRAPER_SECRET or CRON_SECRET> (matches docs/HANDBOOK.md; not the Firecrawl key).
# Trigger via JSON body `{ "trigger": true, "postcode": "M11AG" }` OR query-only `?postcode=M11AG&force=true` (quoted URL in zsh).
# SCRAPER_SECRET=

# Public UK APIs (no keys — npm run test:uk-apis). See docs/PUBLIC-UK-APIS.md:
#   carbonintensity.org.uk, environment.data.gov.uk, api.octopus.energy, air-quality-api.open-meteo.com,
#   postcodes.io, Ofgem via /api/pulse/living
# Profile home_power unlocks UTILITIES Zone tile; Gemini/Firecrawl use FIRE_CRAWL_KEY_2 + GEMINI_API_KEY above.

# Geocode: OpenStreetMap Nominatim (no key). Optional: GEOAPIFY_API_KEY for Geoapify.
# OpenAI (optional, not used by Zai): OPENAI_API_KEY=

# Public app URL (used for deployment-aware links/callbacks in clients).
# For local dev use: http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=https://www.00-00.online

# Phase 0 — durable rate limits (Vercel KV / Upstash Redis REST). Falls back to in-memory when unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Phase 0 — optional Sentry error capture (instrumentation onRequestError + API catch blocks).
# SENTRY_DSN=

# Canonical origin for metadata, sitemap, Open Graph (production: https://www.00-00.online).
NEXT_PUBLIC_SITE_URL=https://www.00-00.online

# Localhost Zone: auto-trigger scrape-sync for unsettled categories on /zone load.
# Default on in `next dev` (127.0.0.1 / localhost). Set to 0 to force JIT-only. Set to 1 on preview if needed.
# NEXT_PUBLIC_ZONE_DEV_BOOTSTRAP=0
